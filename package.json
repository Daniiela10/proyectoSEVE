{
  "name": "proyecto-seve",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix seve-app/frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm install --prefix backend && npm run build --prefix seve-app/frontend",
    "start": "npm start --prefix backend",
    "start:backend": "npm run start --prefix backend"
  },
  "dependencies": {
    "express": "*"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
